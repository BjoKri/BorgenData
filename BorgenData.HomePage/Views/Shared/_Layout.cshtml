@{
    ViewBag.Title = ViewBag.Title + " Borgen Data";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Din lokale data-mann i Sarpsborg. Utfører tjenester innen data.">
    <meta name="keywords" content="PC verksted,Sarpsborg,Data,Reparatør,PC,Verksted,Borgenhaugen,PC hjelp,hjelp">
    <meta name="author" content="borgendata.no">
    
    

    <title>@ViewBag.Title</title>

    <!-- Place favicon.ico and apple-touch-icon.png in the root directory -->
    @Styles.Render("~/Content/Css/Styles")
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bjqs")
    @Scripts.Render("~/bundles/modernizr")

    <script>
        (function (i, s, o, g, r, a, m) {
            i['GoogleAnalyticsObject'] = r; i[r] = i[r] || function () {
                (i[r].q = i[r].q || []).push(arguments)
            }, i[r].l = 1 * new Date(); a = s.createElement(o),
            m = s.getElementsByTagName(o)[0]; a.async = 1; a.src = g; m.parentNode.insertBefore(a, m)
        })(window, document, 'script', 'https://www.google-analytics.com/analytics.js', 'ga');

        ga('create', 'UA-78195233-1', 'auto');
        ga('send', 'pageview');

    </script>

</head>
<body>
    <div id="topMenu">
        </div>
    <div id="container">
        <div id="header">
            <div id="topBanner"></div>
            <nav id="mainNavigation">
                <ul class="menu">
                    <li>@Html.ActionLink("Forside", "Index")</li>
                    <li>@Html.ActionLink("Reparasjon", "Reparasjon")</li>
                    <li>@Html.ActionLink("Oppgradering", "Oppgradering")</li>
                    <li>@Html.ActionLink("Rensing", "Rensing")</li>
                    <li>@Html.ActionLink("Om BorgenData", "Om")</li>
                    <li>@Html.ActionLink("Ta kontakt", "TaKontakt")</li>
                </ul>
            </nav>
        </div>

        
        <div class="main body-content" style="clear: both;">
            @RenderBody()
            </div>
           
        <div class="modal-footer" style="clear: both;">
            <hr />
            <footer>
                <p>&copy; @DateTime.Now.Year - @ViewBag.Title</p>

                <div id="fb-root"></div>
                <script>
                    (function (d, s, id) {
                        var js, fjs = d.getElementsByTagName(s)[0];
                        if (d.getElementById(id)) return;
                        js = d.createElement(s); js.id = id;
                        js.src = "//connect.facebook.net/nb_NO/sdk.js#xfbml=1&version=v2.6";
                        fjs.parentNode.insertBefore(js, fjs);
                    }(document, 'script', 'facebook-jssdk'));</script>

                <div class="fb-like" style="margin:auto" data-href="https://www.facebook.com/Borgen-Data-280158752146712/" data-layout="button" data-action="recommend" data-show-faces="true" data-share="true"></div>
                <div class="fb-follow" style="margin:auto" data-href="https://www.facebook.com/Borgen-Data-280158752146712/" data-layout="button" data-show-faces="false"></div>
                <div class="fb-send" data-href="http://www.borgendata.no/" data-width="50" data-height="50" data-colorscheme="light"></div>

            </footer>
        </div>
    </div>
</body>
</html>
